# NASA FIRMS hotspot API key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Mapbox public token (pk.…) for the 3D map
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Live mode (all optional) ---
# Public URL of the app, added to alert messages
APP_URL=
# Require this token to POST field reports (rangers enter it once on /report)
REPORT_TOKEN=
# Require "Authorization: Bearer <token>" to run the alert check (for the scheduler)
ALERT_CHECK_TOKEN=
# Alert channels: any that are filled in are used; with none, alerts are only logged (dry-run)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AT_USERNAME=
AT_API_KEY=
ALERT_SMS_TO=
ALERT_WEBHOOK_URL=
